  "grammar_rule": {
    "title": "Lenition (séimhiú)",
    "explanation": "In Irish, the initial consonant of a noun can be lenited (séimhiú) after certain words like 'le' (with). This is indicated by adding an h after the initial consonant.",
    "examples": [
      "leabhar (book) → leabhair (with a book)",
      "cathaoir (chair) → chathaoir (with a chair)"
    ]
  },
  "pronunciation_notes": [
    "Irish pronunciation is phonetic, so pronounce each letter.",

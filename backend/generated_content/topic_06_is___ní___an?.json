  "grammar_rule": {
    "title": "Identity and Classification",
    "explanation": "Use 'Is' for affirmative statements, 'Ní' for negative statements, and 'An' for questions.",
    "examples": [
      "Is mise an múinteoir. (I am the teacher.)",
      "Níl sé sin ceart. (That is not right.)",
      "An bhfuil tú sa chistin? (Are you in the kitchen?)"

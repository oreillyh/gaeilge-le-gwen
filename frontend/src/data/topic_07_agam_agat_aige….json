  "grammar_rule": {
    "title": "Using 'agam', 'agat', 'aige', etc.",
    "explanation": "In Irish, possession is indicated by using 'agam' (at me), 'agat' (at you), 'aige' (at him), 'aici' (at her), etc. before the possessed item.",
    "examples": [
      "Tá cat agam. (I have a cat.)",
      "Níl carr agat. (You don't have a car.)",
      "Tá madra aige. (He has a dog.)"
    ]
  },
  "pronunciation_notes": [
    "'agam' is pronounced 'ah-gum'",
    "'agat' is pronounced 'ah-gut'",
    "'aige' is pronounced 'egg-eh'"
  ],

  "grammar_rule": {
    "title": "Using 'D' or 'Chuaigh' for past actions",
    "explanation": "In Irish, the past tense is often formed by adding 'D' before the verb for simple past actions. However, for actions that involve movement, 'Chuaigh' is used instead of 'D'.",

  "grammar_rule": {
    "title": "Using 'Tá' for weather descriptions",
    "explanation": "In Irish, 'Tá' is used to express weather conditions. It is followed by an adjective to describe the weather.",
    "examples": [
      "Tá sé fuar. (It's cold.)",
      "Tá sé tirim. (It's dry.)",
      "Tá sé gaofar. (It's windy.)"
    ]
